# SOL Reversal Sniper — environment example (Phase 2).
# Copy to .env and fill in real values. NEVER commit a real .env.
# No Gemini/AI Studio variables: nothing in this codebase uses them
# (the @google/genai dependency was removed in Phase 2).

# Trading mode — ONE env-driven resolution, shared by bot-service.cjs
# and public/jupiter.js (resolveTradingMode). Mode is configuration, never
# a code edit, never a per-request flag, and never a UI switch: changing
# any value below requires a process restart. Both halves log the resolved
# mode at startup (look for the "TRADING MODE" line).
#
# SOLANA_NETWORK: 'mainnet-beta' (default) | 'devnet'.
#   Legacy alias: DEVNET=true implies devnet when SOLANA_NETWORK is unset.
#   DEVNET HONESTY: the Jupiter perps program ID and custody addresses in
#   this code are MAINNET addresses — there is no devnet perps deployment
#   for this program. Devnet can never broadcast real perps trades: if you
#   combine SOLANA_NETWORK=devnet with live flags, the effective mode is
#   forced to SIMULATE with a loud warning. Do not treat devnet as a
#   live-trading test path.
#
# PAPER_TRADING / SIMULATE_TX ladder (fail closed — each step toward live
# requires explicitly opting OUT of the safer mode):
#   STAGE 1 — PAPER (start here):
#     PAPER_TRADING=true  (SIMULATE_TX ignored)
#     Local virtual fills only. Never touches the chain, never simulates.
#   STAGE 2 — SIMULATE (then this):
#     PAPER_TRADING=false
#     SIMULATE_TX=true
#     On-chain RPC simulation only. Builds the real transaction and
#     simulates it against the RPC, but never broadcasts. No funds move.
#   STAGE 3 — LIVE (only after simulate proves out, and only tiny size):
#     PAPER_TRADING=false
#     SIMULATE_TX=false
#     Real broadcast on SOLANA_NETWORK (use mainnet-beta). Additionally
#     requires, in the SAME process: BOT_AUTH_TOKEN set, a configured
#     wallet keypair, >= 0.02 SOL gas, and the safety toggle armed via
#     /safety-toggle after the audit passes. Without the toggle, live-mode
#     signals are REJECTED (never silently papered).
#   ROLLOUT: paper -> simulate -> tiny live on mainnet (verify the
#   transaction on Solscan) -> scale size only after tiny live verifies.
# The example values below are STAGE 1 (paper). Change them deliberately,
# one stage at a time.
SOLANA_NETWORK=mainnet-beta
PAPER_TRADING=true
SIMULATE_TX=true
KEYPAIR_PATH=./wallet.json
SOLANA_RPC=https://api.mainnet-beta.solana.com
MAINNET_PRIVATE_KEY=

# Priority fees (Phase 2, shared config — see priorityFees.cjs).
# Units: priorityFeeLamports = microLamportsPerCU * computeUnitLimit / 1e6.
# Default 1000 micro-lamports x 400,000 CU = 400 lamports (0.0000004 SOL)
# per transaction. Values above the 50000 cap are clamped with a warning.
# (Correction to the audit: the old 250,000 default cost ~0.0001 SOL/tx,
# not 0.1 SOL/tx — a units error. The new default is still 250x smaller.)
PRIORITY_FEE_MICRO_LAMPORTS=1000
COMPUTE_UNIT_LIMIT=400000

# Fee guard (Phase 2, server switcher). Expected round-trip fees
# (exchange ~0.05%/side + priority) vs the TP1 distance value.
# Above MAX the trade is SKIPPED; above WARN it is placed with a warning.
# Default ON. 0.75 is deliberate: at SOL ~$100 the canonical chop trade
# sits at ~0.51 from exchange fees alone, so 0.50 would veto the whole
# chop regime; 0.75 still blocks fee-dominated trades (chop at SOL > $150).
FEE_GUARD_MAX_FRACTION=0.75
FEE_GUARD_WARN_FRACTION=0.30

# API auth (P0 safety, Phase 1) — REQUIRED in production.
# Set BOT_AUTH_TOKEN to a long random secret (Render secrets). Every
# mutating route (/signal, /close, /wallet-config, /safety-toggle, ...)
# requires: Authorization: Bearer <BOT_AUTH_TOKEN>.
# If NODE_ENV=production and this is unset, all mutating routes refuse
# with 503. In dev without a token, mutating routes are open with a
# startup warning — never deploy that way.
BOT_AUTH_TOKEN=
NODE_ENV=development

# CORS (P0 safety, Phase 1): the single allowed dashboard origin, e.g.
# https://your-app.onrender.com. If unset, no cross-origin access is
# granted (same-origin dashboard use needs no CORS headers).
DASHBOARD_ORIGIN=

# Wallet file encryption (P0 safety, Phase 1) — REQUIRED for any wallet
# file encryption/decryption. New files use AES-256-GCM. There is no
# fallback secret: without this, wallet import/generate/decrypt fail
# closed with a clear error.
WALLET_ENCRYPTION_KEY=

# Telegram Notifications (Optional, server-side only in future work).
# The old browser-side Telegram config (public/config.js) was removed in
# Phase 2: a browser page holding a bot token is a credential leak by
# construction. Do NOT put a Telegram token in any browser-served file.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
